		"_postman_id": "ppn-great-api-collection-v1",
		"name": "PPN GREAT API",
		"description": "Postman Collection สำหรับทดสอบ API ของระบบ PPN GREAT (Auth, Customers, Projects) มีสคริปต์ดึงและบันทึก JWT Token อัตโนมัติ",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.success && response.data && response.data.token) {",
									"    const token = response.data.token;",
									"    const cleanToken = String(token).replace(/^Bearer\\s+/i, '').trim();",
									"    // บันทึก access_token ลงใน Collection Variable อัตโนมัติ",
									"    pm.collectionVariables.set('access_token', cleanToken);",
									"    console.log('บันทึก access_token ลงใน Collection สำเร็จ:', cleanToken);",
									"} else {",
									"    console.error('ไม่พบ Token ในข้อมูลตอบกลับ หรือการล็อกอินไม่สำเร็จ');",
									"}",
									"",
									"// Test Assertions",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Login response returns success as true\", function () {",
									"    pm.expect(response.success).to.be.true;",
									"});",
									"pm.test(\"JWT Token is returned in data\", function () {",
									"    pm.expect(response.data.token).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json; charset=utf-8",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@ppngreat.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
